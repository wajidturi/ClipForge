# Copy to .env and adjust. Every variable is optional; defaults are shown.

# local = single-user desktop mode, server = hosted multi-user mode
CF_MODE=local
# Where media, models, caches and the SQLite database live (default: ./data)
CF_DATA_DIR=./data
# Leave empty to use SQLite inside CF_DATA_DIR.
# PostgreSQL example: postgresql+psycopg://clipforge:clipforge@localhost:5432/clipforge
CF_DATABASE_URL=
# Used to encrypt stored integration secrets. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
CF_SECRET_KEY=change-me
CF_HOST=127.0.0.1
CF_PORT=8800
# Number of worker processes started by `clipforge dev`
CF_WORKERS=2
CF_LOG_LEVEL=INFO
# Log format: console (readable) or json
CF_LOG_FORMAT=console

# AI providers (Phase 4)
ANTHROPIC_API_KEY=
CF_OLLAMA_URL=http://127.0.0.1:11434
