{
  "name": "clipforge-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "cd ../backend && uv run clipforge openapi --out ../frontend/src/lib/api/openapi.json && cd ../frontend && npx -y openapi-typescript@7 src/lib/api/openapi.json -o src/lib/api/schema.d.ts --default-non-nullable false && prettier --write src/lib/api/schema.d.ts src/lib/api/openapi.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "clsx": "^2.1.1",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
